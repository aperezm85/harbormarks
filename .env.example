# HarborMarks — Environment Variables Example

# Authentication (single-user login)
HARBOR_USER=
HARBOR_PASSWORD=

# Session signing key (generate a long random string)
SESSION_SECRET=

# Database connection
DATABASE_URL=postgres://astro:astro@db:5432/harbormarks

PORT=4321 #The port to run the server on
HOST=localhost #The host to run the server on
# HarborMarks — Environment Variables Example
# Copy to `.env` for local non-Docker dev, or mirror these under
# `services.app.environment` in `docker-compose.yml`.
# See README.md "Environment Variables" for the canonical reference
# (required/optional, defaults, restart vs rebuild, where each is read).

# Timezone for the weekly digest scheduler. The digest runs at each user's
# chosen weekday/hour in this timezone (Sunday 07:00 by default).
TZ=UTC

# Database connection (required). In Compose this points at the `db` service.
DATABASE_URL=postgresql://astro:astro@db:5432/harbormarks

# First-start admin bootstrap (required on first start when users table is
# empty). Replace the placeholders before exposing the app on a network.
# Used only when no users exist; ignored afterwards.
HARBOR_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HARBOR_BOOTSTRAP_ADMIN_NAME=Harbor Admin
HARBOR_BOOTSTRAP_ADMIN_PASSWORD=change_me
# Legacy fallback (deprecated): HARBOR_USER / HARBOR_PASSWORD are still
# accepted as bootstrap email/password when the HARBOR_BOOTSTRAP_ADMIN_*
# vars are unset. Prefer the HARBOR_BOOTSTRAP_ADMIN_* names above.

# Registration gate (optional, default "true" when unset). Set to "false" on
# any internet-reachable instance unless you want open registration.
# Read per request — restart only, no rebuild.
HARBOR_ALLOW_SIGNUP=true

# CSRF origin check (optional, default "true"). Keep "true". Read per request.
HARBOR_CHECK_ORIGIN=true
# Required behind a reverse proxy/tunnel: your public hostname(s),
# comma-separated, hostname only (no scheme/port).
HARBOR_ALLOWED_DOMAINS=harbormarks.example.com

# Container runtime (Compose forces these; keep as-is in Docker).
HOST=0.0.0.0
PORT=3000

# Public base URL used for links inside emails (digest, password reset,
# verification). Set this to your public address when behind a reverse proxy,
# otherwise links fall back to the incoming request host.
HARBOR_APP_BASE_URL=https://harbormarks.example.com

# Email delivery (SMTP). Optional, but required for the weekly digest and for
# real password reset / verification emails. Without these, links are logged
# server-side only. HARBOR_SMTP_HOST + HARBOR_SMTP_FROM are the on/off switch.
HARBOR_SMTP_HOST=mail.example.com
HARBOR_SMTP_PORT=587
HARBOR_SMTP_SECURE=false # true for port 465, false for 587 (STARTTLS)
HARBOR_SMTP_USER=harbormarks
HARBOR_SMTP_PASS=change_me
HARBOR_SMTP_FROM=HarborMarks <marks@example.com>

# Optional: shared secret for POST /api/digest/run, used by external schedulers
# (host cron, Uptime Kuma, NAS task runner) instead of the built-in timer.
# HARBOR_CRON_SECRET=use_a_long_random_secret

# Optional: broken link monitoring (daily URL health checks). Off unless
# enabled. Checks run at HARBOR_LINK_HEALTH_HOUR (UTC), HARBOR_LINK_HEALTH_BATCH
# bookmarks per run, pausing HARBOR_LINK_HEALTH_DELAY_MS between requests.
# Dead links get a "Broken" badge, is:broken search, a `broken` tag, and a
# `broken` digest scope. See README.md "Environment Variables".
# HARBOR_LINK_HEALTH_ENABLED=true
# HARBOR_LINK_HEALTH_HOUR=2
# HARBOR_LINK_HEALTH_BATCH=5
# HARBOR_LINK_HEALTH_DELAY_MS=2000

# Optional: CORS origins for browser-extension API access (comma-separated
# origins, e.g. chrome-extension://<extension-id>). Native clients (curl, iOS
# Shortcuts) send no Origin and need nothing here. API keys are managed from
# the profile page and used as `Authorization: Bearer <key>`.
# HARBOR_CORS_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyz123456

# Optional: cookie Secure flag override ("true" / "false" / unset for auto).
# Unset is correct for most deployments (auto-detects https via
# x-forwarded-proto or request URL). Set explicitly only if cookies misbehave
# behind a proxy.
# HARBOR_SECURE_COOKIES=

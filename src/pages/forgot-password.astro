---
export const prerender = false

import { Button } from "@/components/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { Field, FieldGroup, FieldLabel } from "@/components/ui/field"
import HarborMarksHeader from "@/components/ui/HarborMarksHeader.astro"
import { Input } from "@/components/ui/input"
import LayoutLogin from "@/layouts/login.astro"

const status = Astro.url.searchParams.get("status")
---

<LayoutLogin page="Forgot password">
  <div class="flex min-h-screen items-center justify-center bg-background">
    <div class="flex w-full max-w-sm flex-col gap-6">
      <HarborMarksHeader />

      <Card>
        <CardHeader>
          <CardTitle>Reset password</CardTitle>
          <CardDescription>
            Enter your email and we'll generate a reset link.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <form
            method="POST"
            action="/api/auth/password-request"
            class="space-y-4"
          >
            <FieldGroup>
              <Field>
                <FieldLabel htmlFor="email">Email</FieldLabel>
                <Input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="you@example.com"
                />
              </Field>
              <Field>
                <Button type="submit">Generate reset link</Button>
              </Field>
            </FieldGroup>
          </form>
        </CardContent>
      </Card>

      {
        status === "sent" ? (
          <p class="text-sm text-muted-foreground">
            If the account exists, a reset link was generated. Check server
            logs.
          </p>
        ) : null
      }
      <p class="text-sm text-muted-foreground">
        Back to <a href="/login" class="underline">login</a>.
      </p>
    </div>
  </div>
</LayoutLogin>

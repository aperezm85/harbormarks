---
import { DashboardLayout } from "@/components/dashboard/DashboardLayout"
import Layout from "@/layouts/main.astro"
import { DEFAULT_BOOKMARK_PAGE_SIZE, listBookmarks } from "@/lib/bookmarks"
import { parseIndexView, readQueryParam } from "@/lib/search-params"

const userId = Astro.locals.userId
const user = Astro.locals.user
const initialView = parseIndexView(Astro.url.searchParams.get("view"))
const initialQuery = readQueryParam(Astro.url.searchParams)
const rawBookmarks = userId
  ? await listBookmarks(userId, {
      view: initialView,
      search: initialQuery || undefined,
      page: 1,
      pageSize: DEFAULT_BOOKMARK_PAGE_SIZE + 1,
    })
  : []
const bookmarks = rawBookmarks.slice(0, DEFAULT_BOOKMARK_PAGE_SIZE)
const hasMore = rawBookmarks.length > DEFAULT_BOOKMARK_PAGE_SIZE
---

<Layout page="HarborMarks">
  <DashboardLayout
    client:load
    transition:persist
    bookmarks={bookmarks}
    hasMore={hasMore}
    currentUser={user}
    view={initialView}
    initialQuery={initialQuery}
  />
</Layout>

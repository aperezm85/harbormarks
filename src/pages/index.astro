---
import { DashboardLayout } from "@/components/dashboard/DashboardLayout"
import Layout from "@/layouts/main.astro"
import {
  DEFAULT_BOOKMARK_PAGE_SIZE,
  listBookmarks,
  type BookmarkView,
} from "@/lib/bookmarks"

const userId = Astro.locals.userId
const user = Astro.locals.user
function parseIndexView(rawValue: string | null): BookmarkView {
  if (rawValue === "unread") {
    return "unread"
  }

  if (rawValue === "mostVisited") {
    return "mostVisited"
  }

  if (rawValue === "unorganized") {
    return "unorganized"
  }

  return "recent"
}
const initialView = parseIndexView(Astro.url.searchParams.get("view"))
const rawBookmarks = userId
  ? await listBookmarks(userId, {
      view: initialView,
      page: 1,
      pageSize: DEFAULT_BOOKMARK_PAGE_SIZE + 1,
    })
  : []
const bookmarks = rawBookmarks.slice(0, DEFAULT_BOOKMARK_PAGE_SIZE)
const hasMore = rawBookmarks.length > DEFAULT_BOOKMARK_PAGE_SIZE
---

<Layout page="HarborMarks">
  <DashboardLayout
    client:load
    transition:persist
    bookmarks={bookmarks}
    hasMore={hasMore}
    currentUser={user}
    view={initialView}
  />
</Layout>

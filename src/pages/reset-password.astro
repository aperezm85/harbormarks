---
export const prerender = false

import { Button } from "@/components/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { Field, FieldGroup, FieldLabel } from "@/components/ui/field"
import HarborMarksHeader from "@/components/ui/HarborMarksHeader.astro"
import { Input } from "@/components/ui/input"
import LayoutLogin from "@/layouts/login.astro"

const token = Astro.url.searchParams.get("token") ?? ""
let error = Astro.url.searchParams.get("error")
if (error === "Invalid or expired reset token") {
  error = "Invalid or expired reset token."
}
if (error?.startsWith("Password must be at least")) {
  error = "Password must be at least 8 characters."
}
---

<LayoutLogin page="Set new password">
  <div class="flex min-h-screen items-center justify-center bg-background">
    <div class="flex w-full max-w-sm flex-col gap-6">
      <HarborMarksHeader />

      <Card>
        <CardHeader>
          <CardTitle>Set a new password</CardTitle>
          <CardDescription>
            Use the token from your reset link.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <form
            method="POST"
            action="/api/auth/password-reset"
            class="space-y-4"
          >
            <FieldGroup>
              <Field data-invalid={!!error}>
                <FieldLabel htmlFor="token">Reset token</FieldLabel>
                <Input
                  id="token"
                  name="token"
                  required
                  value={token}
                  aria-invalid={!!error}
                />
              </Field>
              <Field data-invalid={!!error}>
                <FieldLabel htmlFor="password">New password</FieldLabel>
                <Input
                  id="password"
                  name="password"
                  type="password"
                  minLength={8}
                  required
                  aria-invalid={!!error}
                />
              </Field>
              <Field>
                <Button type="submit">Update password</Button>
              </Field>
            </FieldGroup>
          </form>
        </CardContent>
      </Card>

      {error ? <p class="text-sm text-destructive">{error}</p> : null}
      <p class="text-sm text-muted-foreground">
        Back to <a href="/login" class="underline">login</a>.
      </p>
    </div>
  </div>
</LayoutLogin>

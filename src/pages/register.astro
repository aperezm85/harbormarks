---
export const prerender = false

import { Button } from "@/components/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"

import { Field, FieldGroup, FieldLabel } from "@/components/ui/field"

import { Input } from "@/components/ui/input"

import HarborMarksHeader from "@/components/ui/HarborMarksHeader.astro"

import ErrorToast from "@/components/ui/ErrorToast"
import LayoutLogin from "@/layouts/login.astro"
import { Toaster } from "sonner"

let error = Astro.url.searchParams.get("error")
if (error === "signup_disabled") {
  error = "Account creation is disabled by this deployment."
}
if (error === "Email is already registered") {
  error = "That email is already registered."
}
if (error === "Email is required") {
  error = "Email is required."
}
if (error === "Name is required") {
  error = "Name is required."
}
if (error?.startsWith("Password must be at least")) {
  error = "Password must be at least 8 characters."
}
---

<LayoutLogin page="Create account">
  <div class="flex min-h-screen items-center justify-center bg-background">
    <div class="flex w-full max-w-sm flex-col gap-6">
      <HarborMarksHeader />

      <Card>
        <CardHeader>
          <CardTitle>Create account</CardTitle>
          <CardDescription>
            Create a local account for this HarborMarks instance
          </CardDescription>
          <CardDescription>
            Already have one? <a href="/login" class="underline">Login</a>
          </CardDescription>
        </CardHeader>
        <CardContent>
          <form method="POST" action="/api/auth/register" class="space-y-4">
            <FieldGroup>
              <Field data-invalid={!!error}>
                <FieldLabel htmlFor="displayName">Name</FieldLabel>
                <Input
                  id="displayName"
                  name="displayName"
                  placeholder="Your name"
                  required
                  aria-invalid={!!error}
                />
              </Field>
              <Field data-invalid={!!error}>
                <FieldLabel htmlFor="email">Email</FieldLabel>
                <Input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="your@email.com"
                  required
                  aria-invalid={!!error}
                />
              </Field>
              <Field data-invalid={!!error}>
                <div class="flex items-center">
                  <FieldLabel htmlFor="password">Password</FieldLabel>
                </div>
                <Input
                  id="password"
                  name="password"
                  type="password"
                  required
                  minLength={8}
                  placeholder="At least 8 characters"
                  aria-invalid={!!error}
                />
              </Field>
              <Field>
                <Button type="submit">Create account</Button>
              </Field>
            </FieldGroup>
          </form>
        </CardContent>
      </Card>
    </div>
  </div>
  <ErrorToast error={error} client:load />
  <Toaster client:load />
</LayoutLogin>

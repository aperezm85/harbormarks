---
export const prerender = false

import { Button } from "@/components/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { Field, FieldGroup, FieldLabel } from "@/components/ui/field"
import Header from "@/components/ui/Header.astro"
import { Input } from "@/components/ui/input"
import ProfileToast from "@/components/ui/ProfileToast"
import Layout from "@/layouts/main.astro"
import { Toaster } from "sonner"

const user = Astro.locals.user

if (!user) {
  return Astro.redirect("/login")
}

const status = Astro.url.searchParams.get("status")
let error = Astro.url.searchParams.get("error")
if (error?.startsWith("Password must be at least")) {
  error = "Password must be at least 8 characters."
}
---

<Layout page="Profile | HarborMarks">
  <div class="relative mx-auto max-w-5xl px-4 py-6">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-40"
    >
    </div>

    <Header />

    <div class="mt-4 mb-6 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Your profile</h1>
        <p class="text-sm text-muted-foreground">
          Manage account details and keep your login secure.
        </p>
      </div>
      <a href="/">
        <Button type="button" variant="outline">&larr; Go back</Button>
      </a>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1fr_1.35fr]">
      <Card className="h-fit">
        <CardHeader>
          <CardTitle>Account details</CardTitle>
          <CardDescription>
            This is how your profile appears across HarborMarks.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <dl class="space-y-3 text-sm">
            <div class="rounded-lg border bg-background p-3">
              <dt class="text-muted-foreground">Display name</dt>
              <dd class="mt-1 font-medium">{user.displayName ?? "Not set"}</dd>
            </div>
            <div class="rounded-lg border bg-background p-3">
              <dt class="text-muted-foreground">Email address</dt>
              <dd class="mt-1 font-medium">{user.email}</dd>
            </div>
            <div class="rounded-lg border bg-background p-3">
              <dt class="text-muted-foreground">Role</dt>
              <dd class="mt-1 font-medium capitalize">{user.role}</dd>
            </div>
          </dl>
        </CardContent>
      </Card>

      <div class="space-y-6">
        <Card>
          <CardHeader>
            <CardTitle>Profile picture</CardTitle>
            <CardDescription>
              Upload a PNG, JPEG, or WebP image (max 512KB) or paste an
              https image URL.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div class="flex items-center gap-4">
              <img
                id="avatar-preview"
                src={user.avatarUrl}
                alt="Your avatar"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="h-16 w-16 rounded-full border object-cover"
              />
              <div class="space-y-2 text-sm">
                <input
                  id="avatar-file"
                  type="file"
                  accept="image/png,image/jpeg,image/webp"
                  class="block text-sm"
                />
                <Input
                  id="avatar-url"
                  type="url"
                  placeholder="https://example.com/avatar.png"
                  value={user.avatarUrl.startsWith("/uploads/") ||
                  user.avatarUrl.startsWith("/api/avatar/") ||
                  user.avatarUrl.startsWith("https://")
                    ? user.avatarUrl.startsWith("data:")
                      ? ""
                      : user.avatarUrl
                    : ""}
                />
              </div>
            </div>
            <p id="avatar-error" class="mt-2 hidden text-sm text-destructive"></p>
            <div class="mt-4 flex gap-2">
              <Button type="button" id="avatar-save">Save avatar</Button>
              <Button type="button" id="avatar-remove" variant="outline"
                >Remove</Button
              >
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Profile</CardTitle>
            <CardDescription>Update your account name.</CardDescription>
          </CardHeader>
          <CardContent>
            <form
              method="POST"
              action="/api/auth/profile-update"
              class="space-y-4"
            >
              <FieldGroup>
                <Field>
                  <FieldLabel htmlFor="displayName">Name</FieldLabel>
                  <Input
                    id="displayName"
                    name="displayName"
                    required
                    value={user.displayName ?? ""}
                    placeholder="Your name"
                  />
                </Field>
                <Field>
                  <FieldLabel htmlFor="email">Email</FieldLabel>
                  <Input id="email" value={user.email} disabled />
                </Field>
                <Field>
                  <Button type="submit">Save profile</Button>
                </Field>
              </FieldGroup>
            </form>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Weekly digest</CardTitle>
            <CardDescription>
              Get an email on Sunday morning with your unread links. Pick
              what it contains, then save.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div class="space-y-4">
              <label
                for="digest-enabled"
                class="flex cursor-pointer items-center gap-2 text-sm font-medium"
              >
                <input
                  id="digest-enabled"
                  type="checkbox"
                  class="h-4 w-4 accent-current"
                />
                Send me the weekly digest
              </label>
              <fieldset class="space-y-2 text-sm">
                <legend class="text-muted-foreground">
                  What should the email contain?
                </legend>
                <label class="flex cursor-pointer items-center gap-2">
                  <input
                    type="radio"
                    name="digest-scope"
                    value="unread_7d"
                    class="h-4 w-4 accent-current"
                  />
                  Unread links from the last 7 days
                </label>
                <label class="flex cursor-pointer items-center gap-2">
                  <input
                    type="radio"
                    name="digest-scope"
                    value="all_unread"
                    class="h-4 w-4 accent-current"
                  />
                  All unread links
                </label>
                <label class="flex cursor-pointer items-center gap-2">
                  <input
                    type="radio"
                    name="digest-scope"
                    value="all_7d"
                    class="h-4 w-4 accent-current"
                  />
                  All links saved in the last 7 days
                </label>
              </fieldset>
              <p id="digest-message" class="hidden text-sm"></p>
              <div class="flex flex-wrap gap-2">
                <Button type="button" id="digest-save">Save digest</Button>
                <Button type="button" id="digest-send" variant="outline">
                  Send now
                </Button>
              </div>
              <p class="text-xs text-muted-foreground">
                "Send now" emails the current selection immediately (max 10
                per hour). If email is not set up by the administrator, saving
                still works but sending reports an error.
              </p>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Change password</CardTitle>
            <CardDescription>
              Updating password will sign you out on all devices.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <form
              method="POST"
              action="/api/auth/profile-password"
              class="space-y-4"
            >
              <FieldGroup>
                <Field>
                  <FieldLabel htmlFor="currentPassword"
                    >Current password</FieldLabel
                  >
                  <Input
                    id="currentPassword"
                    name="currentPassword"
                    type="password"
                    required
                  />
                </Field>
                <Field>
                  <FieldLabel htmlFor="nextPassword">New password</FieldLabel>
                  <Input
                    id="nextPassword"
                    name="nextPassword"
                    type="password"
                    minLength={8}
                    required
                  />
                </Field>
                <Field>
                  <Button type="submit" variant="outline"
                    >Update password</Button
                  >
                </Field>
              </FieldGroup>
            </form>
          </CardContent>
        </Card>
      </div>
    </div>

    <ProfileToast status={status} error={error} client:load />
  <Toaster client:load />
  </div>

  <script>
    const preview = document.getElementById(
      "avatar-preview"
    ) as HTMLImageElement | null
    const fileInput = document.getElementById(
      "avatar-file"
    ) as HTMLInputElement | null
    const urlInput = document.getElementById(
      "avatar-url"
    ) as HTMLInputElement | null
    const errorEl = document.getElementById("avatar-error")
    const saveBtn = document.getElementById("avatar-save")
    const removeBtn = document.getElementById("avatar-remove")

    // NOTE: no static `import { toast } from "sonner"` here — Astro does not
    // bundle bare specifiers in inline scripts, so that import silently
    // fails. Toasts go through the ProfileToast island instead.
    function notifyToast(type: "success" | "error", message: string) {
      window.dispatchEvent(
        new CustomEvent("profile:toast", { detail: { type, message } })
      )
    }

    function isLocalAvatarUrl(avatarUrl: string) {
      return (
        avatarUrl.startsWith("/uploads/") ||
        avatarUrl.startsWith("/api/avatar/")
      )
    }

    function showAvatarError(message: string) {
      if (!errorEl) return
      errorEl.textContent = message
      errorEl.classList.remove("hidden")
    }

    function clearAvatarError() {
      if (!errorEl) return
      errorEl.textContent = ""
      errorEl.classList.add("hidden")
    }

    fileInput?.addEventListener("change", () => {
      const file = fileInput.files?.[0]
      if (file && preview) {
        preview.src = URL.createObjectURL(file)
      }
    })

    function syncAvatarUI(avatarUrl: string) {
      if (preview) {
        preview.src = isLocalAvatarUrl(avatarUrl)
          ? `${avatarUrl}?t=${Date.now()}`
          : avatarUrl
      }
      if (urlInput) {
        urlInput.value =
          isLocalAvatarUrl(avatarUrl) || avatarUrl.startsWith("https://")
            ? avatarUrl
            : ""
      }
      if (fileInput) {
        fileInput.value = ""
      }
    }

    async function postAvatar(body: FormData | string) {
      clearAvatarError()
      const response = await fetch("/api/auth/profile-avatar", {
        method: "POST",
        body,
        headers:
          typeof body === "string" ? { "Content-Type": "application/json" } : {},
      })
      const result = (await response.json().catch(() => null)) as {
        error?: string
        data?: { avatarUrl?: string }
      } | null
      const avatarUrl = result?.data?.avatarUrl
      if (!response.ok || !result || result.error || !avatarUrl) {
        const message = result?.error ?? "Could not save avatar."
        showAvatarError(message)
        notifyToast("error", message)
        return
      }
      syncAvatarUI(avatarUrl)
      notifyToast("success", "Profile updated.")
    }

    saveBtn?.addEventListener("click", () => {
      const file = fileInput?.files?.[0]
      if (file) {
        const form = new FormData()
        form.append("file", file)
        void postAvatar(form)
        return
      }
      void postAvatar(JSON.stringify({ avatarUrl: urlInput?.value ?? "" }))
    })

    removeBtn?.addEventListener("click", () => {
      void postAvatar(JSON.stringify({ avatarUrl: "" }))
    })
  </script>

  <script>
    const digestEnabled = document.getElementById(
      "digest-enabled"
    ) as HTMLInputElement | null
    const digestMessage = document.getElementById("digest-message")
    const digestSave = document.getElementById("digest-save")
    const digestSend = document.getElementById("digest-send")

    function selectedDigestScope(): string {
      const checked = document.querySelector(
        'input[name="digest-scope"]:checked'
      ) as HTMLInputElement | null
      return checked?.value ?? "unread_7d"
    }

    function showDigestMessage(message: string, ok: boolean) {
      if (!digestMessage) return
      digestMessage.textContent = message
      digestMessage.classList.remove("hidden")
      digestMessage.classList.toggle("text-destructive", !ok)
      digestMessage.classList.toggle("text-muted-foreground", ok)
    }

    function notifyDigestToast(type: "success" | "error", message: string) {
      window.dispatchEvent(
        new CustomEvent("profile:toast", { detail: { type, message } })
      )
    }

    async function loadDigestPrefs() {
      try {
        const response = await fetch("/api/digest/preferences")
        if (!response.ok) return
        const result = (await response.json()) as {
          data?: { enabled?: boolean; scope?: string }
        }
        if (digestEnabled && typeof result.data?.enabled === "boolean") {
          digestEnabled.checked = result.data.enabled
        }
        const scope = result.data?.scope
        if (scope) {
          const radio = document.querySelector(
            `input[name="digest-scope"][value="${scope}"]`
          ) as HTMLInputElement | null
          if (radio) radio.checked = true
        }
      } catch {
        // Preferences stay at their defaults; saving still works.
      }
    }

    digestSave?.addEventListener("click", () => {
      const payload = {
        enabled: digestEnabled?.checked ?? false,
        scope: selectedDigestScope(),
      }
      void fetch("/api/digest/preferences", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      })
        .then(async (response) => {
          const result = (await response.json().catch(() => null)) as {
            error?: string
          } | null
          if (!response.ok) {
            const message = result?.error ?? "Could not save digest settings."
            showDigestMessage(message, false)
            notifyDigestToast("error", message)
            return
          }
          showDigestMessage("Digest settings saved.", true)
          notifyDigestToast("success", "Digest settings saved.")
        })
        .catch(() => {
          showDigestMessage("Could not save digest settings.", false)
        })
    })

    digestSend?.addEventListener("click", () => {
      void fetch("/api/digest/send-now", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ scope: selectedDigestScope() }),
      })
        .then(async (response) => {
          const result = (await response.json().catch(() => null)) as {
            error?: string
            data?: { status?: string; count?: number }
          } | null
          if (!response.ok) {
            const message = result?.error ?? "Could not send digest."
            showDigestMessage(message, false)
            notifyDigestToast("error", message)
            return
          }
          const message =
            result?.data?.status === "empty"
              ? "Nothing to send right now — no links match this selection."
              : `Digest sent (${result?.data?.count ?? 0} links). Check your inbox.`
          showDigestMessage(message, true)
          notifyDigestToast("success", message)
        })
        .catch(() => {
          showDigestMessage("Could not send digest.", false)
        })
    })

    void loadDigestPrefs()
  </script>
</Layout>

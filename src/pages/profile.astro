---
export const prerender = false

import { Button } from "@/components/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { Field, FieldGroup, FieldLabel } from "@/components/ui/field"
import { Input } from "@/components/ui/input"
import PageTopBar from "@/components/ui/PageTopBar.astro"
import ProfileToast from "@/components/ui/ProfileToast"
import Layout from "@/layouts/main.astro"
import { Toaster } from "sonner"

const user = Astro.locals.user

if (!user) {
  return Astro.redirect("/login")
}

const status = Astro.url.searchParams.get("status")
let error = Astro.url.searchParams.get("error")
if (error?.startsWith("Password must be at least")) {
  error = "Password must be at least 8 characters."
}
---

<Layout page="Profile | HarborMarks">
  <PageTopBar />

  <div class="mx-auto max-w-3xl space-y-4 p-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Your profile</h1>
        <p class="text-sm text-muted-foreground">
          Manage account details and keep your login secure.
        </p>
      </div>
      <a
        href="/"
        class="inline-flex h-8 shrink-0 items-center justify-center gap-1.5 rounded-lg px-2.5 text-sm font-medium whitespace-nowrap text-muted-foreground transition-all outline-none select-none hover:bg-muted hover:text-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 shrink-0"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Go back
      </a>
    </div>
        <Card>
          <CardHeader>
            <CardTitle>Profile picture</CardTitle>
            <CardDescription>
              Upload a PNG, JPEG, or WebP image (max 512KB) or paste an
              https image URL.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div class="flex items-center gap-4">
              <img
                id="avatar-preview"
                src={user.avatarUrl}
                alt="Your avatar"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="h-16 w-16 rounded-full border object-cover"
              />
              <div class="space-y-2 text-sm">
                <input
                  id="avatar-file"
                  type="file"
                  accept="image/png,image/jpeg,image/webp"
                  class="block text-sm"
                />
                <Input
                  id="avatar-url"
                  type="url"
                  placeholder="https://example.com/avatar.png"
                  value={user.avatarUrl.startsWith("/uploads/") ||
                  user.avatarUrl.startsWith("/api/avatar/") ||
                  user.avatarUrl.startsWith("https://")
                    ? user.avatarUrl.startsWith("data:")
                      ? ""
                      : user.avatarUrl
                    : ""}
                />
              </div>
            </div>
            <p id="avatar-error" class="mt-2 hidden text-sm text-destructive"></p>
            <div class="mt-4 flex gap-2">
              <Button type="button" id="avatar-save">Save avatar</Button>
              <Button type="button" id="avatar-remove" variant="outline"
                >Remove</Button
              >
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Profile</CardTitle>
            <CardDescription>Update your account name.</CardDescription>
          </CardHeader>
          <CardContent>
            <form
              method="POST"
              action="/api/auth/profile-update"
              class="space-y-4"
            >
              <FieldGroup>
                <Field>
                  <FieldLabel htmlFor="displayName">Name</FieldLabel>
                  <Input
                    id="displayName"
                    name="displayName"
                    required
                    value={user.displayName ?? ""}
                    placeholder="Your name"
                  />
                </Field>
                <Field>
                  <FieldLabel htmlFor="email">Email</FieldLabel>
                  <Input id="email" value={user.email} disabled />
                </Field>
                <Field>
                  <Button type="submit">Save profile</Button>
                </Field>
              </FieldGroup>
            </form>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Change password</CardTitle>
            <CardDescription>
              Updating password will sign you out on all devices.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <form
              method="POST"
              action="/api/auth/profile-password"
              class="space-y-4"
            >
              <FieldGroup>
                <Field>
                  <FieldLabel htmlFor="currentPassword"
                    >Current password</FieldLabel
                  >
                  <Input
                    id="currentPassword"
                    name="currentPassword"
                    type="password"
                    required
                  />
                </Field>
                <Field>
                  <FieldLabel htmlFor="nextPassword">New password</FieldLabel>
                  <Input
                    id="nextPassword"
                    name="nextPassword"
                    type="password"
                    minLength={8}
                    required
                  />
                </Field>
                <Field>
                  <Button type="submit" variant="outline"
                    >Update password</Button
                  >
                </Field>
              </FieldGroup>
            </form>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Weekly digest</CardTitle>
            <CardDescription>
              Get an email on your chosen day and time with your unread
              links. Pick what it contains, then save.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div class="space-y-4">
              <label
                for="digest-enabled"
                class="flex cursor-pointer items-center gap-2 text-sm font-medium"
              >
                <input
                  id="digest-enabled"
                  type="checkbox"
                  class="h-4 w-4 accent-current"
                />
                Send me the weekly digest
              </label>
              <fieldset class="space-y-2 text-sm">
                <legend class="text-muted-foreground">
                  What should the email contain?
                </legend>
                <label class="flex cursor-pointer items-center gap-2">
                  <input
                    type="radio"
                    name="digest-scope"
                    value="unread_7d"
                    class="h-4 w-4 accent-current"
                  />
                  Unread links from the last 7 days
                </label>
                <label class="flex cursor-pointer items-center gap-2">
                  <input
                    type="radio"
                    name="digest-scope"
                    value="all_unread"
                    class="h-4 w-4 accent-current"
                  />
                  All unread links
                </label>
                <label class="flex cursor-pointer items-center gap-2">
                  <input
                    type="radio"
                    name="digest-scope"
                    value="all_7d"
                    class="h-4 w-4 accent-current"
                  />
                  All links saved in the last 7 days
                </label>
              </fieldset>
              <fieldset class="space-y-2 text-sm">
                <legend class="text-muted-foreground">When to send</legend>
                <div class="flex flex-wrap gap-2">
                  <label class="flex flex-col gap-1">
                    <span class="text-xs text-muted-foreground">Day</span>
                    <div class="relative">
                      <select
                        id="digest-day"
                        class="h-9 appearance-none rounded-lg border border-input bg-transparent py-2 pr-9 pl-2.5 text-sm transition-colors outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-input/30"
                      >
                        <option value="0" selected>Sunday</option>
                        <option value="1">Monday</option>
                        <option value="2">Tuesday</option>
                        <option value="3">Wednesday</option>
                        <option value="4">Thursday</option>
                        <option value="5">Friday</option>
                        <option value="6">Saturday</option>
                      </select>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute inset-y-0 right-2 flex items-center text-muted-foreground"
                      >
                        <svg
                          class="size-4"
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M6 9L12 15L18 9"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    </div>
                  </label>
                  <label class="flex flex-col gap-1">
                    <span class="text-xs text-muted-foreground">
                      Time (24h)
                    </span>
                    <div class="relative">
                      <select
                        id="digest-time"
                        class="h-9 appearance-none rounded-lg border border-input bg-transparent py-2 pr-9 pl-2.5 text-sm transition-colors outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-input/30"
                      >
                        <option value="00:00">00:00</option>
                        <option value="01:00">01:00</option>
                        <option value="02:00">02:00</option>
                        <option value="03:00">03:00</option>
                        <option value="04:00">04:00</option>
                        <option value="05:00">05:00</option>
                        <option value="06:00">06:00</option>
                        <option value="07:00" selected>07:00</option>
                        <option value="08:00">08:00</option>
                        <option value="09:00">09:00</option>
                        <option value="10:00">10:00</option>
                        <option value="11:00">11:00</option>
                        <option value="12:00">12:00</option>
                        <option value="13:00">13:00</option>
                        <option value="14:00">14:00</option>
                        <option value="15:00">15:00</option>
                        <option value="16:00">16:00</option>
                        <option value="17:00">17:00</option>
                        <option value="18:00">18:00</option>
                        <option value="19:00">19:00</option>
                        <option value="20:00">20:00</option>
                        <option value="21:00">21:00</option>
                        <option value="22:00">22:00</option>
                        <option value="23:00">23:00</option>
                      </select>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute inset-y-0 right-2 flex items-center text-muted-foreground"
                      >
                        <svg
                          class="size-4"
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M6 9L12 15L18 9"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    </div>
                  </label>
                </div>
                <p class="text-xs text-muted-foreground">
                  Times use the server's timezone.
                </p>
              </fieldset>
              <p id="digest-message" class="hidden text-sm"></p>
              <div class="flex flex-wrap gap-2">
                <Button type="button" id="digest-save">Save digest</Button>
                <Button type="button" id="digest-send" variant="outline">
                  Send now
                </Button>
              </div>
              <p class="text-xs text-muted-foreground">
                "Send now" emails the current selection immediately (max 10
                per hour). If email is not set up by the administrator, saving
                still works but sending reports an error.
              </p>
            </div>
          </CardContent>
        </Card>

    <ProfileToast status={status} error={error} client:load />
  <Toaster client:load />
  </div>

  <script>
    const preview = document.getElementById(
      "avatar-preview"
    ) as HTMLImageElement | null
    const fileInput = document.getElementById(
      "avatar-file"
    ) as HTMLInputElement | null
    const urlInput = document.getElementById(
      "avatar-url"
    ) as HTMLInputElement | null
    const errorEl = document.getElementById("avatar-error")
    const saveBtn = document.getElementById("avatar-save")
    const removeBtn = document.getElementById("avatar-remove")

    // NOTE: no static `import { toast } from "sonner"` here — Astro does not
    // bundle bare specifiers in inline scripts, so that import silently
    // fails. Toasts go through the ProfileToast island instead.
    function notifyToast(type: "success" | "error", message: string) {
      window.dispatchEvent(
        new CustomEvent("profile:toast", { detail: { type, message } })
      )
    }

    function isLocalAvatarUrl(avatarUrl: string) {
      return (
        avatarUrl.startsWith("/uploads/") ||
        avatarUrl.startsWith("/api/avatar/")
      )
    }

    function showAvatarError(message: string) {
      if (!errorEl) return
      errorEl.textContent = message
      errorEl.classList.remove("hidden")
    }

    function clearAvatarError() {
      if (!errorEl) return
      errorEl.textContent = ""
      errorEl.classList.add("hidden")
    }

    fileInput?.addEventListener("change", () => {
      const file = fileInput.files?.[0]
      if (file && preview) {
        preview.src = URL.createObjectURL(file)
      }
    })

    function syncAvatarUI(avatarUrl: string) {
      if (preview) {
        preview.src = isLocalAvatarUrl(avatarUrl)
          ? `${avatarUrl}?t=${Date.now()}`
          : avatarUrl
      }
      if (urlInput) {
        urlInput.value =
          isLocalAvatarUrl(avatarUrl) || avatarUrl.startsWith("https://")
            ? avatarUrl
            : ""
      }
      if (fileInput) {
        fileInput.value = ""
      }
    }

    async function postAvatar(body: FormData | string) {
      clearAvatarError()
      const response = await fetch("/api/auth/profile-avatar", {
        method: "POST",
        body,
        headers:
          typeof body === "string" ? { "Content-Type": "application/json" } : {},
      })
      const result = (await response.json().catch(() => null)) as {
        error?: string
        data?: { avatarUrl?: string }
      } | null
      const avatarUrl = result?.data?.avatarUrl
      if (!response.ok || !result || result.error || !avatarUrl) {
        const message = result?.error ?? "Could not save avatar."
        showAvatarError(message)
        notifyToast("error", message)
        return
      }
      syncAvatarUI(avatarUrl)
      notifyToast("success", "Profile updated.")
    }

    saveBtn?.addEventListener("click", () => {
      const file = fileInput?.files?.[0]
      if (file) {
        const form = new FormData()
        form.append("file", file)
        void postAvatar(form)
        return
      }
      void postAvatar(JSON.stringify({ avatarUrl: urlInput?.value ?? "" }))
    })

    removeBtn?.addEventListener("click", () => {
      void postAvatar(JSON.stringify({ avatarUrl: "" }))
    })
  </script>

  <script>
    const digestEnabled = document.getElementById(
      "digest-enabled"
    ) as HTMLInputElement | null
    const digestDay = document.getElementById(
      "digest-day"
    ) as HTMLSelectElement | null
    const digestTime = document.getElementById(
      "digest-time"
    ) as HTMLSelectElement | null
    const digestMessage = document.getElementById("digest-message")
    const digestSave = document.getElementById("digest-save")
    const digestSend = document.getElementById("digest-send")

    function selectedDigestScope(): string {
      const checked = document.querySelector(
        'input[name="digest-scope"]:checked'
      ) as HTMLInputElement | null
      return checked?.value ?? "unread_7d"
    }

    function showDigestMessage(message: string, ok: boolean) {
      if (!digestMessage) return
      digestMessage.textContent = message
      digestMessage.classList.remove("hidden")
      digestMessage.classList.toggle("text-destructive", !ok)
      digestMessage.classList.toggle("text-muted-foreground", ok)
    }

    function notifyDigestToast(type: "success" | "error", message: string) {
      window.dispatchEvent(
        new CustomEvent("profile:toast", { detail: { type, message } })
      )
    }

    async function loadDigestPrefs() {
      try {
        const response = await fetch("/api/digest/preferences")
        if (!response.ok) return
        const result = (await response.json()) as {
          data?: { enabled?: boolean; scope?: string; sendDay?: number; sendTime?: string }
        }
        if (digestEnabled && typeof result.data?.enabled === "boolean") {
          digestEnabled.checked = result.data.enabled
        }
        const scope = result.data?.scope
        if (scope) {
          const radio = document.querySelector(
            `input[name="digest-scope"][value="${scope}"]`
          ) as HTMLInputElement | null
          if (radio) radio.checked = true
        }
        if (digestDay && typeof result.data?.sendDay === "number") {
          digestDay.value = String(result.data.sendDay)
        }
        if (digestTime && typeof result.data?.sendTime === "string") {
          // The dropdown only offers whole hours. Older settings saved as
          // free text (e.g. "09:10") fall back to their hour; the stored
          // value is unchanged until the next save.
          const match = /^([01]\d|2[0-3]):([0-5]\d)$/.exec(
            result.data.sendTime.trim()
          )
          if (match) {
            digestTime.value = `${match[1]}:00`
          }
        }
      } catch {
        // Preferences stay at their defaults; saving still works.
      }
    }

    digestSave?.addEventListener("click", () => {
      const rawDay = digestDay?.value.trim() ?? ""
      const parsedDay = rawDay === "" ? undefined : Number.parseInt(rawDay, 10)
      const rawTime = digestTime?.value.trim() ?? ""
      const payload = {
        enabled: digestEnabled?.checked ?? false,
        scope: selectedDigestScope(),
        sendDay: parsedDay,
        sendTime: rawTime === "" ? undefined : rawTime,
      }
      void fetch("/api/digest/preferences", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      })
        .then(async (response) => {
          const result = (await response.json().catch(() => null)) as {
            error?: string
          } | null
          if (!response.ok) {
            const message = result?.error ?? "Could not save digest settings."
            showDigestMessage(message, false)
            notifyDigestToast("error", message)
            return
          }
          showDigestMessage("Digest settings saved.", true)
          notifyDigestToast("success", "Digest settings saved.")
        })
        .catch(() => {
          showDigestMessage("Could not save digest settings.", false)
        })
    })

    digestSend?.addEventListener("click", () => {
      void fetch("/api/digest/send-now", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ scope: selectedDigestScope() }),
      })
        .then(async (response) => {
          const result = (await response.json().catch(() => null)) as {
            error?: string
            data?: { status?: string; count?: number }
          } | null
          if (!response.ok) {
            const message = result?.error ?? "Could not send digest."
            showDigestMessage(message, false)
            notifyDigestToast("error", message)
            return
          }
          const message =
            result?.data?.status === "empty"
              ? "Nothing to send right now — no links match this selection."
              : `Digest sent (${result?.data?.count ?? 0} links). Check your inbox.`
          showDigestMessage(message, true)
          notifyDigestToast("success", message)
        })
        .catch(() => {
          showDigestMessage("Could not send digest.", false)
        })
    })

    void loadDigestPrefs()
  </script>
</Layout>

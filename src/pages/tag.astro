---
import { DashboardLayout } from "@/components/dashboard/DashboardLayout"
import Layout from "@/layouts/main.astro"
import { listBookmarks } from "@/lib/bookmarks"

const userId = Astro.locals.userId
const user = Astro.locals.user
const selectedTag = Astro.url.searchParams.get("tag")?.trim() ?? ""
const bookmarks =
  userId && selectedTag ? await listBookmarks(userId, { tag: selectedTag }) : []
---

<Layout
  page={selectedTag ? `Tag: ${selectedTag} | HarborMarks` : "Tag | HarborMarks"}
>
  <DashboardLayout
    client:load
    transition:persist
    bookmarks={bookmarks}
    currentUser={user}
    tagFilter={selectedTag}
  />
</Layout>

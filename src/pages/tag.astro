---
import { DashboardLayout } from "@/components/dashboard/DashboardLayout"
import Layout from "@/layouts/main.astro"
import { listBookmarks } from "@/lib/bookmarks"

const selectedTag = Astro.url.searchParams.get("tag")?.trim() ?? ""
const bookmarks = selectedTag ? await listBookmarks({ tag: selectedTag }) : []
---

<Layout
  page={selectedTag ? `Tag: ${selectedTag} | HarborMarks` : "Tag | HarborMarks"}
>
  <DashboardLayout
    client:load
    transition:persist
    bookmarks={bookmarks}
    tagFilter={selectedTag}
  />
</Layout>

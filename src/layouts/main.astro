---
import { ModeToggle } from "@/components/ui/ModeToggle"
import "@/styles/global.css"

interface Props {
  page: string
}

const { page = "HarborMarks" } = Astro.props
const isAuthenticated = Astro.locals.isAuthenticated === true
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme")
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light"
  }
  const isDark = getThemePreference() === "dark"
  document.documentElement.classList[isDark ? "add" : "remove"]("dark")

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark")
      localStorage.setItem("theme", isDark ? "dark" : "light")
    })
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    })
  }
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{page}</title>
  </head>
  <body>
    <div class="fixed top-4 right-4 z-50 flex items-center gap-2">
      <ModeToggle client:load />
      {
        isAuthenticated && (
          <form method="POST" action="/api/auth/logout">
            <button
              type="submit"
              class="inline-flex h-8 items-center justify-center rounded-lg border border-border bg-background px-3 text-sm font-medium transition-colors hover:bg-muted"
            >
              Logout
            </button>
          </form>
        )
      }
    </div>
    <slot />
  </body>
</html>

---
import Logo from "@/assets/harborMark.svg"

interface Props {
  justify?: "center" | "start" | "end"
}

const { justify = "center" } = Astro.props
---

<div class={`flex w-full items-center justify-${justify}`}>
  <Logo class="mr-2 h-8 w-8" />
  <h1 class="text-4xl font-bold">
    Harbor<span class="text-primary">Marks</span>
  </h1>
</div>

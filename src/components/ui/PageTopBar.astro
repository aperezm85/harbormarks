---
import Logo from "@/assets/harborMark.svg"

import { Button } from "./button"
import { ModeToggle } from "./ModeToggle"

const isAuthenticated = Astro.locals.isAuthenticated === true
---

<header
  class="sticky top-0 z-30 flex h-14 shrink-0 items-center gap-2 border-b border-border bg-background/80 px-4 backdrop-blur-md"
>
  <a
    href="/"
    aria-label="Back to home"
    class="flex shrink-0 items-center gap-2"
  >
    <Logo class="h-6 w-6" />
    <span class="text-lg font-bold">
      Harbor<span class="text-primary">Marks</span>
    </span>
  </a>
  <div class="flex-1"></div>
  <ModeToggle client:load />
  {
    isAuthenticated && (
      <form method="POST" action="/api/auth/logout">
        <Button variant="outline" type="submit">
          Logout
        </Button>
      </form>
    )
  }
</header>
